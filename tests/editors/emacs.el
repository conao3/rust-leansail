;;; -*- lexical-binding: t; -*-
(require 'eglot)
(require 'json)
(require 'cl-lib)

(defvar leansail-config
  (json-parse-string
   (with-temp-buffer
     (insert-file-contents (getenv "LEANSAIL_EDITOR_CONFIG"))
     (buffer-string))
   :object-type 'plist :array-type 'list))
(defvar leansail-results nil)
(defvar leansail-hover nil)

(defun leansail-wait (predicate)
  (let ((deadline (+ (float-time) 30)))
    (while (not (funcall predicate))
      (when (> (float-time) deadline) (error "エディタの応答待ちが期限を超えました"))
      (accept-process-output nil 0.05)
      (sit-for 0.01))))

(defun leansail-record (key value)
  (push (cons key value) leansail-results))

(defun leansail-position (line column)
  (goto-char (point-min))
  (forward-line line)
  (forward-char column))

(defun leansail-errors ()
  (cl-loop for diag in (flymake-diagnostics)
           when (eq (flymake-diagnostic-type diag) 'eglot-error)
           collect (flymake-diagnostic-text diag)))

(defun leansail-ready ()
  (eglot--signal-textDocument/didChange)
  (jsonrpc-request (eglot-current-server) :textDocument/waitForDiagnostics
                   `(:uri ,(eglot-path-to-uri buffer-file-name) :version ,eglot--docver))
  (flymake-start)
  (accept-process-output nil 0.1))

(defun leansail-edit (text)
  (erase-buffer)
  (mapc (lambda (char) (insert char) (accept-process-output nil 0.002)) text)
  (leansail-ready))

(define-derived-mode leansail-test-mode prog-mode "Lean")

(let* ((has-lean-mode (require 'lean4-mode nil t))
       (mode (if has-lean-mode 'lean4-mode 'leansail-test-mode))
       (file (plist-get leansail-config :file))
       (trusted-content (list (abbreviate-file-name file)))
       (original (with-temp-buffer (insert-file-contents file) (buffer-string)))
       (eglot-server-programs `((,mode . ,(plist-get leansail-config :command))))
       (eglot-sync-connect t)
       (eglot-connect-timeout 30)
       (eglot-send-changes-idle-time 0.01)
       (eglot-autoshutdown nil)
       (enable-local-variables nil)
       (server nil))
  (find-file file)
  (funcall mode)
  (eglot-ensure)
  (run-hooks 'post-command-hook)
  (leansail-wait (lambda () (eglot-current-server)))
  (setq server (eglot-current-server))
  (leansail-ready)
  (leansail-wait (lambda () (= (length (leansail-errors)) 2)))
  (leansail-record 'mode (symbol-name mode))
  (leansail-record 'version emacs-version)
  (leansail-record 'diagnostics (vconcat (leansail-errors)))
  (flymake-show-buffer-diagnostics)
  (unless (cl-some (lambda (buffer)
                     (with-current-buffer buffer
                       (and (derived-mode-p 'flymake-diagnostics-buffer-mode)
                            (string-match-p "Type mismatch" (buffer-string))
                            (string-match-p "Unknown constant" (buffer-string)))))
                   (buffer-list))
    (error "Flymake の診断一覧を表示できません"))
  (switch-to-buffer (get-file-buffer file))
  (leansail-position 1 9)
  (eglot-hover-eldoc-function (lambda (text &rest _) (setq leansail-hover text)))
  (leansail-wait (lambda () leansail-hover))
  (unless (string-match-p "editorValue : Nat" leansail-hover)
    (error "hover の内容が一致しません: %s" leansail-hover))
  (leansail-record 'hover (substring-no-properties leansail-hover))
  (xref-find-definitions "editorValue")
  (unless (and (= (line-number-at-pos) 1) (= (current-column) 4))
    (error "定義への移動先が一致しません"))
  (leansail-record 'definition (vector (1- (line-number-at-pos)) (current-column)))
  (leansail-position 5 13)
  (let* ((capf (eglot-completion-at-point))
         (prefix (buffer-substring-no-properties (nth 0 capf) (point)))
         (items (all-completions prefix (nth 2 capf))))
    (unless (member "succ" items) (error "補完候補に succ がありません: %s" items))
    (leansail-record 'completion (vconcat (mapcar #'substring-no-properties items))))
  (leansail-position 3 2)
  (let ((goal (jsonrpc-request server :$/lean/plainGoal (eglot--TextDocumentPositionParams))))
    (unless (string-match-p "n = n" (plist-get goal :rendered))
      (error "ゴールが一致しません: %s" goal))
    (with-help-window "*Lean goal*" (princ (plist-get goal :rendered)))
    (unless (get-buffer-window "*Lean goal*") (error "ゴールを表示できません"))
    (leansail-record 'goal goal))
  (leansail-edit (replace-regexp-in-string "true" "false" original))
  (leansail-wait (lambda () (cl-some (lambda (s) (string-match-p "false" s)) (leansail-errors))))
  (leansail-record 'typing_diagnostics (vconcat (leansail-errors)))
  (leansail-edit (replace-regexp-in-string "Nat.su\n" "Nat.succ\n"
					   (replace-regexp-in-string "true" "42" original)))
  (leansail-wait (lambda () (null (leansail-errors))))
  (leansail-record 'clean_diagnostics [])
  (set-buffer-modified-p nil)
  (kill-buffer)
  (find-file file)
  (funcall mode)
  (eglot-ensure)
  (run-hooks 'post-command-hook)
  (leansail-wait (lambda () (eglot-current-server)))
  (unless (eq server (eglot-current-server)) (error "再オープンでサーバーが変わりました"))
  (leansail-ready)
  (leansail-wait (lambda () (= (length (leansail-errors)) 2)))
  (leansail-record 'reopen_diagnostics (vconcat (leansail-errors)))
  (add-hook 'kill-emacs-hook
            (lambda ()
              (let ((process (jsonrpc--process server)))
                (eglot-shutdown server nil 10)
                (leansail-record 'exit_status (process-exit-status process)))
              (with-temp-file (plist-get leansail-config :result)
                (insert (json-encode leansail-results))))))
